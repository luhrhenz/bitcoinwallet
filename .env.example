# Copy to .env and fill in. .env is ignored by git; never commit real values.

# Network: testnet4 (default), signet or regtest
BTCW_NETWORK=testnet4

# Bitcoin node RPC. A hosted https endpoint (e.g. Alchemy testnet4) needs no user/password.
BTCW_RPC_URL=https://bitcoin-testnet4.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Assistant (desktop app): free key from https://console.groq.com
GROQ_API_KEY=YOUR_GROQ_KEY
# Optional: override the Groq model (must support tool calling). Default: openai/gpt-oss-120b
# GROQ_MODEL=openai/gpt-oss-120b
