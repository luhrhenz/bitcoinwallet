# Set these in Vercel (Project → Settings → Environment Variables), never in git.
# Bitcoin testnet4 JSON-RPC endpoint, e.g. Alchemy: https://bitcoin-testnet4.g.alchemy.com/v2/<key>
ALCHEMY_RPC_URL=
# Groq API key for the assistant (console.groq.com)
GROQ_API_KEY=
# Optional: Groq model (must support tool calling). Default: openai/gpt-oss-120b
GROQ_MODEL=
